# --- Core ---
ENVIRONMENT=development            # development | production
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# In development, if empty, a random ephemeral key is generated at startup (tokens reset on restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./hospital_flow.db
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/hospital_flow

# Comma-separated list of explicitly permitted frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Seed data (development only) ---
# Password for demo users created by `python -m app.seed`. If empty, a random one is generated and printed once.
SEED_USER_PASSWORD=

# --- Optional AI provider (core operations work without these) ---
LLM_PROVIDER=none                  # none | anthropic | openai
LLM_API_KEY=
LLM_MODEL=                         # e.g. a model id from your provider's documentation
LLM_BASE_URL=                      # optional override (OpenAI-compatible gateways)
LLM_TIMEOUT_SECONDS=30

# --- Optional MCP (not used by default) ---
MCP_SERVER_URL=
